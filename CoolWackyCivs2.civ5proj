<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Deploy" ToolsVersion="4.0">
  <PropertyGroup>
    <Name>Cool Wacky Civs 2</Name>
    <Teaser>Eleven civilizations: an endless city, wings, a champion, a lobby, prayer, clockwork, a circus, eleven cats, Saba, a classroom and sentient traffic cones.</Teaser>
    <Description>The Boundless City, The Republic of Pigeons, The Indigo Champion, McPvP - The Endless Lobby, The Children of the Kingdom, The Twelfth Hour, The Wandering Circus, The 11 Cats, The Kingdom of Saba, The Substitute Classroom and The Conical Union. Requires BNW and Community Patch v151. See the included civilization guides.</Description>
    <Authors>SolusGo</Authors>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs2</Homepage>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <Guid>f6859d5b-50bf-4a7e-b5d3-bdc2d6e69392</Guid>
    <ProjectGuid>{AA4AD1C1-C12D-4D53-9CB9-19714C36EA01}</ProjectGuid>
    <ModVersion>13</ModVersion>
    <SafeName>CoolWackyCivs2</SafeName>
    <AssemblyName>CoolWackyCivs2</AssemblyName>
    <RootNamespace>CoolWackyCivs2</RootNamespace>
    <Stability>Alpha</Stability>
    <Civ5UserPath>$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
