<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Deploy" ToolsVersion="4.0">
  <PropertyGroup>
    <Name>Cool Wacky Civs 2</Name>
    <Teaser>One city. A world without an end.</Teaser>
    <Description>The Boundless City: contiguous cultural frontier growth, real citizen reservations for distant tiles, the Grand Registry, Frontier Surveyors and The Boundless Workforce. Requires BNW and Community Patch v151. See the included guide for native engine limits.</Description>
    <Authors>SolusGo</Authors>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs2</Homepage>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <Guid>f6859d5b-50bf-4a7e-b5d3-bdc2d6e69392</Guid>
    <ProjectGuid>{AA4AD1C1-C12D-4D53-9CB9-19714C36EA01}</ProjectGuid>
    <ModVersion>4</ModVersion>
    <SafeName>CoolWackyCivs2</SafeName>
    <AssemblyName>CoolWackyCivs2</AssemblyName>
    <RootNamespace>CoolWackyCivs2</RootNamespace>
    <Stability>Alpha</Stability>
    <Civ5UserPath>$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>TheBoundlessCity/SQL/00_BC_Core.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>TheBoundlessCity/SQL/01_BC_Inheritance.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>TheBoundlessCity/SQL/02_BC_Effects.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>TheBoundlessCity/SQL/03_BC_Art.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>TheBoundlessCity/SQL/10_BC_Text.sql</FileName>
      </Action>
    </ModActions>
    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Boundless Workforce</Name>
        <Description>Boundless gameplay and UI</Description>
        <FileName>TheBoundlessCity/UI/BoundlessWorkforce.xml</FileName>
      </Content>
    </ModContent>
    <ModDependencies>
      <Association>
        <Type>Dlc</Type>
        <Name>Expansion - Brave New World</Name>
        <Id>6DA07636-4123-4018-B643-6575B4EC336B</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
      <Association>
        <Type>Mod</Type>
        <Name>(1) Community Patch</Name>
        <Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id>
        <MinVersion>151</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
