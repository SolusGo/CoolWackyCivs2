    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Boundless Workforce</Name>
        <Description>One simulation owner and an event-driven workforce panel.</Description>
        <FileName>TheBoundlessCity/UI/BoundlessWorkforce.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Messages on the Wing</Name>
        <Description>Pigeon trade-route yields and Rooftop Roost production.</Description>
        <FileName>TheRepublicOfPigeons/UI/PigeonTrade.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Champion Team</Name>
        <Description>Trainer Red simulation and event-driven Champion Team panel.</Description>
        <FileName>TrainerRed/UI/RED_TeamPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>McPvP Server Browser</Name>
        <Description>Persistent matches, kits, objectives and Server Legacy.</Description>
        <FileName>McPvP/UI/MCP_ServerBrowser.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Prayer</Name>
        <Description>Human-only prayer petitions, permanent Grace and event-driven blessings.</Description>
        <FileName>TheChildrenOfTheKingdom/UI/CK_Prayer.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Grand Clock</Name>
        <Description>Human-only six-turn Grand Chime, staged before native yield settlement.</Description>
        <FileName>TheTwelfthHour/UI/TWELFTH_Clock.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Show Must Go On</Name>
        <Description>Local three-turn Grand Festivals, persistent city cooldowns and Ticket Offices.</Description>
        <FileName>TheWanderingCircus/UI/WanderingCircus.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Household</Name>
        <Description>Austin and ten persistent companions, resident effects, family bonds and safe recovery.</Description>
        <FileName>The11Cats/UI/THE11CATS_Household.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Sabaean Water Management</Name>
        <Description>Invisible city-location yield reconciliation; no gameplay panel.</Description>
        <FileName>KingdomOfSaba/Lua/SABA_Cities.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Roll Call</Name>
        <Description>Mr. Garvey: persistent attendance, corrections and Detention with an event-driven classroom panel.</Description>
        <FileName>TheSubstituteClassroom/UI/GARVEY_RollCall.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Connected Administration</Name>
        <Description>Conical Union city connection yields and conditional Detour Office Gold; no gameplay panel.</Description>
        <FileName>TheConicalUnion/Lua/ConicalUnion.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Silence Before the Storm</Name>
        <Description>Human-only Quietude, Silent Belfry yields and persistent Great Toll windows.</Description>
        <FileName>KingdomOfTheUnrungBell/Lua/UnrungBell.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Strength Potion Inventory</Name>
        <Description>Human-only Urgal stockpiles, timed melee attacks against units and cities, Pot Chaser and speed-scaled Aftertaste.</Description>
        <FileName>TheUrgal/UI/URGAL_Potions.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Jin Dynasty</Name>
        <Description>Human-only Grasslands, Horse recruitment, Emissaries, Landmarks and automatic defenses.</Description>
        <FileName>JinDynasty/UI/JIN_Dynasty.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Threshold Transfer</Name>
        <Description>Human-only city doorway transfers, persistent cooldowns and exhausted original units.</Description>
        <FileName>TheThresholdCourt/UI/THC_Transfer.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>A Thousand Small Hands</Name>
        <Description>Human-only shared worked-Plantation snapshots, city yields and Honey Exchange Gold.</Description>
        <FileName>TheHoneycombCommonwealth/Lua/HCC_Commonwealth.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Evergreen Crown</Name>
        <Description>Human-only achievement recognition, Golden Age modifiers and Hall of Laurels progress.</Description>
        <FileName>TheLaureateCommonwealth/Lua/LC_Commonwealth.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>ZOFGK Roster</Name>
