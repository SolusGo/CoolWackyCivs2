<?xml version='1.0' encoding='utf-8'?>
<Mod id="f6859d5b-50bf-4a7e-b5d3-bdc2d6e69392" version="19">
  <Properties>
    <Name>Cool Wacky Civs 2</Name>
    <Teaser>Eighteen civilizations, now including Faker and T1 - The ZOFGK Dynasty.</Teaser>
    <Description>The Boundless City, The Republic of Pigeons, The Indigo Champion, McPvP - The Endless Lobby, The Children of the Kingdom, The Twelfth Hour, The Wandering Circus, The 11 Cats, The Kingdom of Saba, The Substitute Classroom, The Conical Union, The Kingdom of the Unrung Bell, The Urgal, The Jin Dynasty, The Threshold Court, The Honeycomb Commonwealth, The Laureate Commonwealth and T1 - The ZOFGK Dynasty. Requires BNW and Community Patch v151. See the included civilization guides.</Description>
    <Authors>SolusGo</Authors>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs2</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
